{
  "name": "@local/dsh-team-crew",
  "version": "1.1.9",
  "private": true,
  "type": "module",
  "description": "Agent Teams 补票插件：队友模型/思考挡位热切换（保记忆）+ 软删除（退役）+ 人类自助换脑台（GUI 面板与 /crew 命令），液态玻璃主题自适应。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangdogdaihuman/dsh-team-crew.git"
  },
  "keywords": ["dsh", "deepseek-harness", "agent-teams", "plugin", "cordis"],
  "meta": {
    "title": "Team Crew Tools",
    "description": "Adds set_teammate_model (hot model switch, context kept), retire_teammate (soft delete), the /crew command, and a conversation-header desk so the human can switch a teammate's model without the agent."
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
